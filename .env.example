# Copy to .env. Never commit .env.
# Azure AI Foundry project endpoint and model deployment
PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-name>
MODEL_DEPLOYMENT_NAME=gpt-4o-mini
# Public HTTPS URL of the MCP server (for example your ngrok URL + /mcp)
MCP_SERVER_URL=https://<your-ngrok-domain>/mcp
MCP_SERVER_LABEL=corp_secure_mcp
